generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model aisles {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id String    @db.Uuid
  zone_id    String    @db.Uuid
  name       String    @db.VarChar(50)
  deleted_at DateTime? @db.Timestamptz(6)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  companies  companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  zones      zones     @relation(fields: [zone_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  racks      racks[]
}

model branches {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id String       @db.Uuid
  name       String       @db.VarChar(255)
  address    String?
  deleted_at DateTime?    @db.Timestamptz(6)
  created_at DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at DateTime?    @default(now()) @db.Timestamptz(6)
  companies  companies    @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  warehouses warehouses[]
}

model clients {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id          String            @db.Uuid
  name                String            @db.VarChar(255)
  tax_id              String?           @db.VarChar(50)
  is_internal_company Boolean           @default(true)
  deleted_at          DateTime?         @db.Timestamptz(6)
  created_at          DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?         @default(now()) @db.Timestamptz(6)
  companies           companies         @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inventory_items     inventory_items[]
}

model companies {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String                @db.VarChar(255)
  tax_id              String                @unique @db.VarChar(50)
  address             String?
  phone               String?               @db.VarChar(50)
  is_active           Boolean               @default(true)
  deleted_at          DateTime?             @db.Timestamptz(6)
  created_at          DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?             @default(now()) @db.Timestamptz(6)
  aisles              aisles[]
  branches            branches[]
  clients             clients[]
  cost_history        cost_history[]
  cost_profiles       cost_profiles[]
  inventory_items     inventory_items[]
  inventory_movements inventory_movements[]
  levels              levels[]
  products            products[]
  racks               racks[]
  roles               roles[]
  storage_locations   storage_locations[]
  executive_portfolio_history executive_portfolio_history[]
  subscriptions       subscriptions[]
  user_company_access user_company_access[]
  users               users[]
  warehouses          warehouses[]
  zones               zones[]
}

model cost_history {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id         String        @db.Uuid
  cost_profile_id    String        @db.Uuid
  previous_cost      Decimal       @db.Decimal(12, 2)
  new_cost           Decimal       @db.Decimal(12, 2)
  currency           String        @default("CLP") @db.VarChar(3)
  change_reason      String?
  changed_by_user_id String?       @db.Uuid
  created_at         DateTime?     @default(now()) @db.Timestamptz(6)
  users              users?        @relation(fields: [changed_by_user_id], references: [id], onUpdate: NoAction)
  companies          companies     @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  cost_profiles      cost_profiles @relation(fields: [cost_profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model cost_profiles {
  id                        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id                String         @db.Uuid
  zone_id                   String?        @db.Uuid
  rack_id                   String?        @db.Uuid
  level_id                  String?        @db.Uuid
  daily_base_cost           Decimal        @default(0.00) @db.Decimal(12, 2)
  currency                  String         @default("CLP") @db.VarChar(3)
  turnover_multiplier       Decimal        @default(1.00) @db.Decimal(5, 2)
  maintenance_cost_daily    Decimal        @default(0.00) @db.Decimal(12, 2)
  energy_cost_daily         Decimal        @default(0.00) @db.Decimal(12, 2)
  seasonal_factor           Decimal        @default(1.00) @db.Decimal(5, 2)
  ai_suggested_cost         Decimal?       @db.Decimal(12, 2)
  custom_formula_expression String?
  is_active                 Boolean        @default(true)
  deleted_at                DateTime?      @db.Timestamptz(6)
  created_at                DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at                DateTime?      @default(now()) @db.Timestamptz(6)
  cost_history              cost_history[]
  companies                 companies      @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  levels                    levels?        @relation(fields: [level_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  racks                     racks?         @relation(fields: [rack_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  zones                     zones?         @relation(fields: [zone_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model inventory_items {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id          String                @db.Uuid
  product_id          String                @db.Uuid
  storage_location_id String                @db.Uuid
  client_owner_id     String                @db.Uuid
  quantity            Int                   @default(1)
  lot_number          String?               @db.VarChar(100)
  expiration_date     DateTime?             @db.Date
  occupancy_type      String                @default("BOXES") @db.VarChar(20)
  occupied_m3         Decimal               @default(0.000) @db.Decimal(10, 3)
  entered_at          DateTime?             @default(now()) @db.Timestamptz(6)
  created_at          DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?             @default(now()) @db.Timestamptz(6)
  clients             clients               @relation(fields: [client_owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  companies           companies             @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products            products              @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  storage_locations   storage_locations     @relation(fields: [storage_location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inventory_movements inventory_movements[]

  @@index([company_id, storage_location_id], map: "idx_inventory_items_location")
  @@index([company_id, product_id], map: "idx_inventory_items_product")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model inventory_movements {
  id                                                                               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id                                                                       String             @db.Uuid
  inventory_item_id                                                                String             @db.Uuid
  movement_type                                                                    String             @db.VarChar(20)
  source_location_id                                                               String?            @db.Uuid
  destination_location_id                                                          String?            @db.Uuid
  quantity                                                                         Int
  performed_by_user_id                                                             String?            @db.Uuid
  created_at                                                                       DateTime?          @default(now()) @db.Timestamptz(6)
  companies                                                                        companies          @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  storage_locations_inventory_movements_destination_location_idTostorage_locations storage_locations? @relation("inventory_movements_destination_location_idTostorage_locations", fields: [destination_location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inventory_items                                                                  inventory_items    @relation(fields: [inventory_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                                                                            users?             @relation(fields: [performed_by_user_id], references: [id], onUpdate: NoAction)
  storage_locations_inventory_movements_source_location_idTostorage_locations      storage_locations? @relation("inventory_movements_source_location_idTostorage_locations", fields: [source_location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([company_id, created_at(sort: Desc)], map: "idx_movements_company_date")
}

model levels {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id        String              @db.Uuid
  rack_id           String              @db.Uuid
  level_number      Int
  height_cm         Decimal?            @db.Decimal(10, 2)
  width_cm          Decimal?            @db.Decimal(10, 2)
  depth_cm          Decimal?            @db.Decimal(10, 2)
  max_weight_kg     Decimal?            @db.Decimal(10, 2)
  total_volume_m3   Decimal?            @default(dbgenerated("COALESCE((((height_cm * width_cm) * depth_cm) / 1000000.0), (0)::numeric)")) @db.Decimal(10, 3)
  deleted_at        DateTime?           @db.Timestamptz(6)
  created_at        DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?           @default(now()) @db.Timestamptz(6)
  cost_profiles     cost_profiles[]
  companies         companies           @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  racks             racks               @relation(fields: [rack_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  storage_locations storage_locations[]

  @@index([company_id, rack_id], map: "idx_levels_rack")
}

model plans {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String          @unique @db.VarChar(50)
  max_warehouses Int             @default(1)
  max_users      Int             @default(5)
  max_storage_m3 Decimal         @default(500.00) @db.Decimal(12, 2)
  price_monthly  Decimal         @default(0.00) @db.Decimal(10, 2)
  currency       String          @default("CLP") @db.VarChar(3)
  is_active      Boolean         @default(true)
  created_at     DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?       @default(now()) @db.Timestamptz(6)
  subscriptions  subscriptions[]
}

model products {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id      String            @db.Uuid
  sku             String            @db.VarChar(100)
  name            String            @db.VarChar(255)
  unit_weight_kg  Decimal           @default(0.00) @db.Decimal(10, 2)
  unit_volume_m3  Decimal           @default(0.0000) @db.Decimal(10, 4)
  is_palletized   Boolean           @default(false)
  deleted_at      DateTime?         @db.Timestamptz(6)
  created_at      DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?         @default(now()) @db.Timestamptz(6)
  inventory_items inventory_items[]
  companies       companies         @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([company_id, sku], map: "uq_product_sku_company")
}

model racks {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id    String          @db.Uuid
  aisle_id      String          @db.Uuid
  code          String          @db.VarChar(50)
  position_x    Int             @default(0)
  position_y    Int             @default(0)
  width_units   Int             @default(1)
  length_units  Int             @default(1)
  rotation_deg  Int             @default(0)
  deleted_at    DateTime?       @db.Timestamptz(6)
  created_at    DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?       @default(now()) @db.Timestamptz(6)
  cost_profiles cost_profiles[]
  levels        levels[]
  aisles        aisles          @relation(fields: [aisle_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  companies     companies       @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([company_id, aisle_id], map: "idx_racks_aisle")
}

model roles {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id     String?    @db.Uuid
  code           String     @db.VarChar(50)
  name           String     @db.VarChar(100)
  permissions    Json       @default("[]")
  is_system_role Boolean    @default(false)
  created_at     DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?  @default(now()) @db.Timestamptz(6)
  companies      companies? @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users[]

  @@unique([company_id, code], map: "uq_role_company_code")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model storage_locations {
  id                                                                                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id                                                                         String                @db.Uuid
  level_id                                                                           String                @db.Uuid
  code                                                                               String                @db.VarChar(100)
  max_weight_kg                                                                      Decimal?              @db.Decimal(10, 2)
  total_volume_m3                                                                    Decimal               @default(0.000) @db.Decimal(10, 3)
  occupied_volume_m3                                                                 Decimal               @default(0.000) @db.Decimal(10, 3)
  status                                                                             String                @default("AVAILABLE") @db.VarChar(20)
  deleted_at                                                                         DateTime?             @db.Timestamptz(6)
  created_at                                                                         DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at                                                                         DateTime?             @default(now()) @db.Timestamptz(6)
  inventory_items                                                                    inventory_items[]
  inventory_movements_inventory_movements_destination_location_idTostorage_locations inventory_movements[] @relation("inventory_movements_destination_location_idTostorage_locations")
  inventory_movements_inventory_movements_source_location_idTostorage_locations      inventory_movements[] @relation("inventory_movements_source_location_idTostorage_locations")
  companies                                                                          companies             @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  levels                                                                             levels                @relation(fields: [level_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([company_id, level_id], map: "idx_storage_loc_level")
}

model subscriptions {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id           String    @db.Uuid
  plan_id              String    @db.Uuid
  status               String    @default("ACTIVE") @db.VarChar(20)
  current_period_start DateTime  @db.Timestamptz(6)
  current_period_end   DateTime  @db.Timestamptz(6)
  cancel_at_period_end Boolean   @default(false)
  created_at           DateTime? @default(now()) @db.Timestamptz(6)
  updated_at           DateTime? @default(now()) @db.Timestamptz(6)
  companies            companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  plans                plans     @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model user_company_access {
  user_id    String    @db.Uuid
  company_id String    @db.Uuid
  granted_at DateTime? @default(now()) @db.Timestamptz(6)
  companies  companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, company_id])
}

model user_sessions {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String    @db.Uuid
  refresh_token_hash String    @unique @db.VarChar(255)
  user_agent         String?
  ip_address         String?   @db.VarChar(45)
  is_revoked         Boolean   @default(false)
  expires_at         DateTime  @db.Timestamptz(6)
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  users              users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([refresh_token_hash], map: "idx_user_sessions_token")
}

model user_warehouse_assignments {
  user_id      String     @db.Uuid
  warehouse_id String     @db.Uuid
  access_level String     @default("FULL") @db.VarChar(20)
  assigned_at  DateTime?  @default(now()) @db.Timestamptz(6)
  warehouses   warehouses @relation(fields: [warehouse_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_wh_assignment_wh")
  users        users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, warehouse_id])
}

model users {
  id                         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  primary_company_id         String?                      @db.Uuid
  role_id                    String                       @db.Uuid
  email                      String                       @unique @db.VarChar(255)
  password_hash              String                       @db.VarChar(255)
  full_name                  String                       @db.VarChar(255)
  is_active                  Boolean                      @default(true)
  deleted_at                 DateTime?                    @db.Timestamptz(6)
  created_at                 DateTime?                    @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime?                    @default(now()) @db.Timestamptz(6)
  cost_history               cost_history[]
  inventory_movements        inventory_movements[]
  user_company_access        user_company_access[]
  user_sessions              user_sessions[]
  user_warehouse_assignments user_warehouse_assignments[]
  executive_history_assigned executive_portfolio_history[] @relation("executive_portfolio_history_executive_user_idTousers")
  executive_history_performed executive_portfolio_history[] @relation("executive_portfolio_history_assigned_by_user_idTousers")
  companies                  companies?                   @relation(fields: [primary_company_id], references: [id], onUpdate: NoAction)
  roles                      roles                        @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([primary_company_id], map: "idx_users_company")
}

model executive_portfolio_history {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  executive_user_id   String    @db.Uuid
  company_id          String    @db.Uuid
  action              String    @db.VarChar(20)
  assigned_by_user_id String?   @db.Uuid
  reason              String?
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  companies           companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  executive_user      users     @relation("executive_portfolio_history_executive_user_idTousers", fields: [executive_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assigned_by_user    users?    @relation("executive_portfolio_history_assigned_by_user_idTousers", fields: [assigned_by_user_id], references: [id], onUpdate: NoAction)

  @@index([executive_user_id], map: "idx_portfolio_history_executive")
  @@index([company_id], map: "idx_portfolio_history_company")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model warehouses {
  id                         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id                 String                       @db.Uuid
  branch_id                  String?                      @db.Uuid
  name                       String                       @db.VarChar(255)
  code                       String                       @db.VarChar(50)
  map_layout_json            Json?                        @default("{}")
  is_cost_tracking_enabled   Boolean                      @default(false)
  deleted_at                 DateTime?                    @db.Timestamptz(6)
  created_at                 DateTime?                    @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime?                    @default(now()) @db.Timestamptz(6)
  user_warehouse_assignments user_warehouse_assignments[]
  branches                   branches?                    @relation(fields: [branch_id], references: [id], onUpdate: NoAction)
  companies                  companies                    @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  zones                      zones[]

  @@unique([company_id, code], map: "uq_warehouse_code_company")
  @@index([company_id], map: "idx_warehouses_company")
}

model zones {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id    String          @db.Uuid
  warehouse_id  String          @db.Uuid
  name          String          @db.VarChar(100)
  turnover_rate String          @default("MEDIUM") @db.VarChar(20)
  deleted_at    DateTime?       @db.Timestamptz(6)
  created_at    DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?       @default(now()) @db.Timestamptz(6)
  aisles        aisles[]
  cost_profiles cost_profiles[]
  companies     companies       @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  warehouses    warehouses      @relation(fields: [warehouse_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([company_id, warehouse_id], map: "idx_zones_warehouse")
}
